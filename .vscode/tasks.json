{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run DES backend",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"backend/run.py"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run DES frontend",
			"type": "shell",
			"command": "Set-Location 'react-des'; npm run dev -- --host 0.0.0.0",
			"isBackground": true,
			"group": "build"
		}
	]
}